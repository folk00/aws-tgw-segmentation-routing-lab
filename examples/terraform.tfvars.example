aws_region   = "us-east-1"
project_name = "aws-tgw-segmentation-lab"
owner        = "lab-owner"
environment  = "study"

# Keep true for the full learning path with SSM validation.
# Set to false if you only want TGW/VPC route-table objects.
enable_validation_instances = true

instance_type = "t3.micro"

